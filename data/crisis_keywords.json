{
  "$schema": "./concepts/_schema.json",
  "schema_version": "0.1.0",
  "schema_note": "Phase 0 辅助资产 #4 危机关键词表:Phase 1 危机检测模块(/crisis)埋点数据源;关键词按 6 大类组织(自杀意念/自伤行为/绝望无意义/冲动暴力/严重焦虑发作/物质滥用),共 89 词条,4 级 severity(critical/high/medium/low),low 留作扩展;严禁用于自动决策,只做安全网触发。",
  "code": "CRISIS_KEYWORDS",
  "name": "心理危机关键词检测表",
  "name_en": "Crisis Keywords Dictionary",
  "version": "0.1.0",
  "updated_at": "2026-09-03",
  "owner": "10-心理-Psychology",
  "intro": "PsychologyAdvisor 危机检测埋点数据源。覆盖中文语境下 6 大类常见危机信号关键词(自杀意念/自伤行为/绝望无意义/冲动暴力/严重焦虑发作/物质滥用),共 89 词条。每条带 severity(4 级:critical/high/medium/low)与 response_action(立即资源弹窗/温和关切追问/记录观察/留作扩展)。**关键设计原则**:① 严守'只做安全网,不做诊断'边界,不引导细节、不替代专业咨询;② 触发即展示资源,不追问;③ 误报宽容(critical 优先级确保 high 不漏报);④ 所有命中记录脱敏入 crisis_events 表(无原始文本),用于后续评审与模型迭代。",
  "design_principles": [
    "只做安全网,不做诊断,不引导细节",
    "触发即弹资源,不追问'你想怎么做'等危险对话",
    "critical 级别宁可误报不漏报",
    "所有命中脱敏记录(crisis_events 表存 trigger_keywords,不存原文)",
    "任何升级/降级逻辑走人工 review,不在客户端自动判定"
  ],
  "severity_levels": {
    "critical": {
      "label": "立即介入",
      "response_action": "show_emergency_resources",
      "ui_pattern": "fullscreen_modal",
      "max_typing_latency_ms": 200,
      "description": "直接表达死亡意愿/计划/手段,或正在进行自伤,需立即弹出 24h 热线资源"
    },
    "high": {
      "label": "强烈关切",
      "response_action": "show_resources_and_empathy",
      "ui_pattern": "persistent_banner",
      "max_typing_latency_ms": 500,
      "description": "存在自伤/自杀念头但未表达具体计划,或严重绝望,需温和资源推荐 + 情感支持"
    },
    "medium": {
      "label": "温和关切",
      "response_action": "log_and_soft_offer",
      "ui_pattern": "inline_suggestion",
      "max_typing_latency_ms": 1000,
      "description": "高频风险信号(持续低落/失眠/孤立),不立即弹窗,记录观察 + 末尾柔和提供资源入口"
    }
  },
