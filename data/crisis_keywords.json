  "matching_rules": {
    "algorithm": "exact_substring + jieba_token_fallback",
    "case_sensitive": false,
    "whole_word": false,
    "negation_window_chars": 6,
    "negation_words": ["不是", "不会", "别", "没有", "不"],
    "context_window_chars": 50,
    "co_occurrence_upgrade": "若同一输入中同时出现 cat_suicidal_ideation 与 cat_hopelessness 任一 high 词,整体升级为 critical",
    "performance_budget_ms": 50,
    "debounce_ms": 800,
    "max_keystrokes_per_minute": 240
  },
  "audit_and_logging": {
    "log_storage": "data/crisis_events (Phase 1 后端建表,字段:user_id, trigger_keywords, severity, resources_shown, created_at)",
    "log_pii_policy": "DO NOT store original user text; store only matched keyword list + severity",
    "review_cadence": "weekly by psychology consultant (10-心理-Psychology)",
    "false_positive_review_threshold": "若某词 30 日内 false positive 率 > 70%,触发 downgrade review",
    "false_negative_review_threshold": "若收到 1 例已知漏报,立即全表 review 该 category 全部词"
