# PsychologyAdvisor · 环境变量示例
#
# 0918 T3 新增 · Docker Compose 一键启动的 env 文件模板
#
# 使用方法:
#   cp .env.example .env
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"   # 生成强 secret
#   # 把输出粘贴到 .env 的 PSY_JWT_SECRET=
#
# 安全:
#   - .env 已 .gitignore(见根 .gitignore + 本文件末尾注释),不要提交
#   - 生产环境必须改 PSY_JWT_SECRET,默认 dev 占位严禁上线

# --------------------------------------------------------------------
# 必填:0917 T3 JWT HS256 签发密钥(手签 HS256 需要,见 backend/main.py)
# --------------------------------------------------------------------
# 生成方式:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# 默认 dev 占位(dev 模式可用,生产必须替换):
PSY_JWT_SECRET=please-change-me-in-production-use-python3-secrets-token-urlsafe-32

# --------------------------------------------------------------------
# 可选:日记存储目录(容器内固定,可不配)
# --------------------------------------------------------------------
# default: /app/backend/data/diary_store
# PSY_DIARY_DIR=/app/backend/data/diary_store

# --------------------------------------------------------------------
# 可选:对外端口(默认 8080,可不配)
# --------------------------------------------------------------------
# host 端口映射,在 docker-compose.yml ports 段生效,本文件只是文档提示
# FRONTEND_PORT=8080